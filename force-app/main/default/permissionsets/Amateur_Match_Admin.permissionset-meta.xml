    <!-- Match_Level__c Field Permission -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Match__c.Match_Level__c</field>
        <readable>true</readable>
    </fieldPermissions>
    
    <fieldPermissions>
        <editable>true</editable>
        <field>Match_Period__c.Match_Level__c</field>
        <readable>true</readable>
    </fieldPermissions>
    
    <fieldPermissions>
        <editable>true</editable>
        <field>Match_Participation__c.Match_Level__c</field>
