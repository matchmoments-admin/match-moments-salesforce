    </fieldPermissions>
    
    <fieldPermissions>
        <editable>true</editable>
        <field>Lineup__c.Match_Level__c</field>
        <readable>true</readable>
    </fieldPermissions>
    
    <!-- Match__c Key Fields -->
    <!-- Note: Status__c, Match_Date_Time__c, Home_Team__c, and Away_Team__c are required fields, so FLS cannot be set in permission sets -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Match__c.Home_Score_Final__c</field>
        <readable>true</readable>
    </fieldPermissions>
    
    <fieldPermissions>
        <editable>true</editable>
        <field>Match__c.Away_Score_Final__c</field>
