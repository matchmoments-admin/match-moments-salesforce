<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Social Share Widget</masterLabel>
    <description>Reusable social share buttons for Twitter, Facebook, WhatsApp, and more</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="variant" type="String" default="full" label="Variant" description="Display variant: full, compact, or icons-only" />
            <property name="showQrCode" type="Boolean" default="false" label="Show QR Code" description="Display QR code for sharing" />
            <property name="showStats" type="Boolean" default="false" label="Show Stats" description="Display engagement statistics" />
            <objects>
                <object>Commentary_Event__c</object>
            </objects>
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="variant" type="String" default="full" label="Variant" description="Display variant: full, compact, or icons-only" />
            <property name="showQrCode" type="Boolean" default="false" label="Show QR Code" description="Display QR code for sharing" />
            <property name="showStats" type="Boolean" default="false" label="Show Stats" description="Display engagement statistics" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
