<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Get Sport Data</masterLabel>
    <description>Headless LWC for ESPN Quick Actions - syncs sport data from ESPN API</description>
    <targets>
        <target>lightning__RecordAction</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordAction">
            <actionType>Action</actionType>
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Account</object>
                <object>Contact</object>
                <object>Opportunity</object>
                <object>Opportunity_Group__c</object>
                <object>Fixture__c</object>
                <object>Competition__c</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>