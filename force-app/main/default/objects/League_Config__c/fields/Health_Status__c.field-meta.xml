<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Health_Status__c</fullName>
    <description>Auto-calculated health based on last sync time</description>
    <externalId>false</externalId>
    <formula>IF(Last_Full_Sync__c &gt; NOW() - 2, "Healthy", 
IF(Last_Full_Sync__c &gt; NOW() - 6, "Degraded", "Failed"))</formula>
    <label>Health Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>

